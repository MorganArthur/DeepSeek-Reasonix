XIAOMI_API_KEY=sk-your-key-here
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_API_KEY and MIMO_BASE_URL are accepted as aliases of XIAOMI_*.
# XIAOMI_API_BASE_URL is accepted as an alias of XIAOMI_BASE_URL.
# Legacy DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL still read during the migration
# window, but will be removed in a future release — please migrate.
REASONIX_LOG_LEVEL=INFO
REASONIX_TRANSCRIPT_DIR=./transcripts
